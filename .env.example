# Copie estas variáveis para o Netlify: Site configuration → Environment variables
# (NUNCA coloque os valores reais no GitHub)

# Token de acesso permanente da Meta (usuário do sistema)
WHATSAPP_TOKEN=EAAG...

# Senha que você inventa e cola também na tela de webhook da Meta
WHATSAPP_VERIFY_TOKEN=deo-verifica-2026

# App Secret (Meta → seu app → Configurações do app → Básico)
META_APP_SECRET=abc123...

# IDs dos números (WhatsApp → Configuração da API → "Identificação do número de telefone")
REPAIR_PHONE_NUMBER_ID=123456789012345
DEV_PHONE_NUMBER_ID=987654321098765

# Seu WhatsApp pessoal (com 55 + DDD), para receber os avisos e comandar o bot
DONO_WHATSAPP=5521999999999

# Senha do painel de pedidos (/painel?token=...)
ADMIN_TOKEN=troque-por-uma-senha-longa

# Opcional — atendimento com IA (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...
IA_MODELO=claude-haiku-5-5

# Opcional
ATENDENTE_HORAS=12
GRAPH_VERSION=v25.0

# ---------------- Instagram e Messenger (v3) ----------------
# ID do app (Meta → seu app → Configurações do app → Básico) — evita que o bot se pause sozinho
META_APP_ID=1234567890

# Token da Página (Meta → seu app → Messenger/Instagram → Configuração da API → Gerar token)
REPAIR_PAGE_TOKEN=EAAG...
DEV_PAGE_TOKEN=EAAG...

# Opcional: números do WhatsApp e sites já estão em src/negocios/*.mjs.
# Use estas variáveis só se quiser trocar sem mexer no código.
# REPAIR_WHATSAPP_NUMERO=5521992291220
# DEV_WHATSAPP_NUMERO=5521966986094
# REPAIR_SITE_URL=https://deorepair.netlify.app/
# DEV_SITE_URL=https://deo-dev.netlify.app/

# ID da conta do Instagram (aparece no painel do app ao conectar o Instagram)
REPAIR_IG_ID=17841400000000000
DEV_IG_ID=17841400000000001

# Opcional: só se o ID da Página for diferente do que está em src/negocios/*.mjs
# REPAIR_PAGE_ID=61595494169589
# DEV_PAGE_ID=61595093687313

# v13: chave da API do YCloud (YCloud → Developers → API Keys). Obrigatória para a Deo Dev responder.
YCLOUD_API_KEY=
